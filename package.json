{
	"name": "pi-patch",
	"version": "0.1.0",
	"description": "pi extension: an exact port of hermes' 'patch' tool — tolerant 9-strategy matching, teaching errors with 'did you mean' sections, model-facing diffs, and a V4A apply_patch mode — replacing the built-in edit tool.",
	"type": "module",
	"main": "src/index.ts",
	"scripts": {
		"test": "vitest run",
		"typecheck": "tsc --noEmit"
	},
	"keywords": [
		"pi",
		"extension",
		"edit",
		"patch",
		"fuzzy-matching"
	],
	"license": "MIT",
	"engines": {
		"node": ">=20"
	},
	"dependencies": {
		"diff": "^8.0.4"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "1.2.0",
		"@earendil-works/pi-tui": "^1.2.0",
		"@types/node": "^22.0.0",
		"typescript": "^5.7.0",
		"vitest": "^3.0.0"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": ">=1.2.0",
		"@earendil-works/pi-tui": ">=1.2.0",
		"typebox": ">=1.3.0"
	}
}
